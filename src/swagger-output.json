   "/bulk-orders/": {
    "post": {
      "description": "Create a new bulk order",
      "parameters": [
        {
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": [
              "customerName",
              "phone",
              "deliveryDate",
              "deliveryTime",
              "totalAmount",
              "products"
            ],
            "properties": {
              "customerName": {
                "type": "string",
                "example": "Raj Kumar"
              },
              "phone": {
                "type": "string",
                "example": "9876543210"
              },
              "email": {
                "type": "string",
                "example": "raj@example.com"
              },
              "deliveryDate": {
                "type": "string",
                "format": "date",
                "example": "2026-10-15"
              },
              "deliveryTime": {
                "type": "string",
                "example": "14:30"
              },
              "totalAmount": {
                "type": "number",
                "example": 5000
              },
              "advancePaid": {
                "type": "number",
                "example": 2000
              },
              "occasion": {
                "type": "string",
                "example": "Birthday"
              },
              "specialInstructions": {
                "type": "string",
                "example": "Please write Happy Birthday on the cake"
              },
              "createdBy": {
                "type": "integer",
                "example": 1
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "productId",
                    "productName",
                    "quantity",
                    "unit",
                    "rate",
                    "amount"
                  ],
                  "properties": {
                    "productId": {
                      "type": "integer",
                      "example": 10
                    },
                    "productName": {
                      "type": "string",
                      "example": "Chocolate Cake"
                    },
                    "quantity": {
                      "type": "number",
                      "example": 2
                    },
                    "unit": {
                      "type": "string",
                      "example": "kg"
                    },
                    "rate": {
                      "type": "number",
                      "example": 800
                    },
                    "amount": {
                      "type": "number",
                      "example": 1600
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "responses": {
        "201": {
          "description": "Bulk order created successfully"
        },
        "400": {
          "description": "Bad request"
        }
      }
    },
    "get": {
      "description": "Get all bulk orders",
      "responses": {
        "200": {
          "description": "Bulk orders retrieved successfully"
        },
        "500": {
          "description": "Internal server error"
        }
      }
    }
  },

  "/bulk-orders/{id}/status": {
    "patch": {
      "description": "Update bulk order status",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer",
          "example": 1
        },
        {
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "example": "Completed",
                "enum": [
                  "Upcoming",
                  "Confirmed",
                  "Preparing",
                  "Ready",
                  "Completed",
                  "Cancelled"
                ]
              }
            }
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Status updated successfully"
        },
        "404": {
          "description": "Order not found"
        },
        "500": {
          "description": "Internal server error"
        }
      }
    }
